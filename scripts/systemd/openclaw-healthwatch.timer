# openclaw-healthwatch.timer — cadence for the gateway health probe
# (issue #53, epic #48). First run 2 min after boot, then every 30 s
# after the previous service activation (OnUnitActiveSec), with 5 s
# accuracy slack. Persistent=true so a missed cycle (e.g. VM was off)
# catches up on the next boot instead of being dropped.
#
# WantedBy=timers.target — the timer, not the service, is the enabled
# unit; the same-named openclaw-healthwatch.service is triggered by it.

[Unit]
Description=OpenClaw gateway health probe cadence

[Timer]
OnBootSec=2min
OnUnitActiveSec=30s
AccuracySec=5s
Persistent=true

[Install]
WantedBy=timers.target
